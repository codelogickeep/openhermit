{
  "name": "@codelogickeep/open-hermit",
  "version": "2.1.24",
  "description": "OpenHermit (开源寄居蟹) - Claude Code 钉钉监控服务。接收 Claude Code Hook 事件，推送到钉钉。",
  "main": "src/index.js",
  "bin": {
    "openhermit": "./src/index.js"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai-agent",
    "dingtalk",
    "hooks",
    "monitoring",
    "notifications",
    "openhermit"
  ],
  "author": "CodeLogicKeep",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codelogickeep/openhermit.git"
  },
  "homepage": "https://github.com/codelogickeep/openhermit#readme",
  "bugs": {
    "url": "https://github.com/codelogickeep/openhermit/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dingtalk-stream-sdk-nodejs": "^2.0.4",
    "dotenv": "^16.3.1",
    "lodash.debounce": "^4.0.8",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "vitest": "^1.2.0"
  }
}
